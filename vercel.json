{
  "rewrites": [
    {
      "source": "/api/fill-i765",
      "destination": "/api/fill?form=i765"
    },
    {
      "source": "/api/fill-i90",
      "destination": "/api/fill?form=i90"
    },
    {
      "source": "/api/fill-n400",
      "destination": "/api/fill?form=n400"
    },
    {
      "source": "/api/fill-i130",
      "destination": "/api/fill?form=i130"
    },
    {
      "source": "/api/fill-i485",
      "destination": "/api/fill?form=i485"
    },
    {
      "source": "/api/fill-i589",
      "destination": "/api/fill?form=i589"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/fill.py": {
      "maxDuration": 60,
      "includeFiles": ["public/forms/**", "api/build-mode.json"]
    },
    "api/assessment-save.js": {
      "maxDuration": 10,
      "includeFiles": ["api/build-mode.json"]
    },
    "api/assessment-resume.js": {
      "maxDuration": 10
    },
    "api/generate-form.js": {
      "includeFiles": ["api/build-mode.json"]
    }
  },
  "buildCommand": "npm run build && bash scripts/bundle-form-engine.sh"
}
