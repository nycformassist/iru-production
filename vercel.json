{
  "rewrites": [
    {
      "source": "/api/fill-i765",
      "destination": "/api/fill?form=i765"
    },
    {
      "source": "/api/fill-i90",
      "destination": "/api/fill?form=i90"
    },
    {
      "source": "/api/fill-n400",
      "destination": "/api/fill?form=n400"
    },
    {
      "source": "/api/fill-i130",
      "destination": "/api/fill?form=i130"
    },
    {
      "source": "/api/fill-i485",
      "destination": "/api/fill?form=i485"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/fill.py": {
      "maxDuration": 60
    },
    "api/assessment-save.js": {
      "maxDuration": 10
    },
    "api/assessment-resume.js": {
      "maxDuration": 10
    }
  },
  "buildCommand": "which uv || echo 'UV NOT FOUND'; python3 --version; ls -la requirements.txt pyproject.toml api/requirements.txt 2>&1; uv pip install -r requirements.txt"
}