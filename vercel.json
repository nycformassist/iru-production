{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/fill-*.py": {
      "maxDuration": 60
    },
    "api/assessment-save.js": {
      "maxDuration": 10
    },
    "api/assessment-resume.js": {
      "maxDuration": 10
    }
  },
  "buildCommand": "npm run build && bash scripts/bundle-form-engine.sh"
}